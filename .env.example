# KOSIS OpenAPI 인증 키
# https://kosis.kr/openapi/ 에서 발급받으세요
KOSIS_API_KEY=your_api_key_here

# Redis (compose가 자동 주입 — 로컬 단독 실행 시만 필요)
# REDIS_URL=redis://localhost:6379/0

# 캐시 설정 (시간 단위)
CACHE_TTL_HOURS=6

# HTTP (선택)
# PORT=3000
# RATE_LIMIT_RPM=60
# MCP_AUTH_TOKEN=
# ACCESS_LOG=1

# Vercel 배포 시 Dashboard 또는 `vercel env add`로 설정
# REDIS_URL=  # Upstash Redis 연동 시 (미설정이면 인메모리 캐시)
# MCP_CORS_ORIGIN=*

# Langfuse tracing (선택 — 미설정 시 observe no-op)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://langfuse.clabi.kr
# LANGFUSE_TRACING_ENVIRONMENT=dev
